# DBS quarantine / secrets safety
Archive/quarantine/

# Secret-like local files
**/.env
**/.env.*
**/*.key

# Local tool state
.claude/
**/.claude/
.codex/
worktree-backups/
graphify-out/
*.lnk

# OneDrive conflict copies
*-DESKTOP-*.md

# Legacy app repo path - do not track from SLOPS root if it reappears
ssffmvp/

# Omen is a separate git repo - do not track app source from SLOPS root.
slops-saloon/omen/

# Codex-generated artifact backups - do not track
Solutions/.codex-artifacts/

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Vendored upstream agent skills, installed by `npx skills add`.
# Treated like node_modules: reproducible from skills-lock.json, which IS tracked and
# carries a content hash per skill. Authorship of OUR skills stays in Blueprints/skills/.
# A fresh clone therefore reports NEEDS-INSTALL from check-skill-deps.mjs, which is correct.
.agents/

# Vendored legal-template checkouts (open-agreements). Third-party content with its own
# .git, pinned by commit in compliance-by-template/SKILL.md and reproducible from it.
# Treated like node_modules and .agents/ — the pin is tracked, the payload is not.
References/legal-templates/
