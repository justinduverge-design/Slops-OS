{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slops:direction:v1:decision",
  "title": "DBS Direction decision v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id", "schema_version", "id", "date", "created_at", "updated_at",
    "repository", "status", "decision", "context", "rationale",
    "alternatives", "supersedes", "superseded_by", "consequences",
    "affected_artifacts", "owner", "approver", "source", "links"
  ],
  "properties": {
    "schema_id": { "const": "slops.direction.decision" },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^(SLOPS|OMEN)-DEC-[0-9]{8}-[0-9]{3}$" },
    "date": { "type": "string", "format": "date" },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" },
    "repository": { "enum": ["slops-os", "omen"] },
    "status": { "enum": ["PROPOSED", "ACCEPTED", "SUPERSEDED", "REJECTED"] },
    "decision": { "type": "string", "minLength": 1 },
    "context": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "alternatives": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "$ref": "#/$defs/linkList" },
    "superseded_by": { "$ref": "#/$defs/linkList" },
    "consequences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "affected_artifacts": { "$ref": "#/$defs/linkList" },
    "owner": { "type": "string", "minLength": 1 },
    "approver": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "links": { "type": "object" },
    "legacy_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "migrated_from": { "type": ["object", "null"] }
  },
  "$defs": {
    "linkList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(dbs|https)://" },
      "uniqueItems": true
    }
  }
}
