{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slops:direction:v1:session-close",
  "title": "DBS Direction session close v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id", "schema_version", "id", "created_at", "updated_at",
    "repository", "objective", "outcome", "decisions_made",
    "work_completed", "current_state", "superseded_assumptions",
    "unresolved_questions", "next_actions", "files_and_sources_touched",
    "validation_evidence", "direction_updates_completed",
    "blueprint_updates_completed", "owner", "source", "links"
  ],
  "properties": {
    "schema_id": { "const": "slops.direction.session-close" },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^(SLOPS|OMEN)-SES-[0-9]{8}-[0-9]{3}$" },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" },
    "repository": { "enum": ["slops-os", "omen"] },
    "objective": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED", "CANCELLED"] },
    "decisions_made": { "$ref": "#/$defs/linkList" },
    "work_completed": { "$ref": "#/$defs/nonEmptyStrings" },
    "current_state": { "type": "string", "minLength": 1 },
    "superseded_assumptions": { "type": "array", "items": { "type": "string" } },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "object" } },
    "files_and_sources_touched": { "$ref": "#/$defs/linkList" },
    "validation_evidence": { "type": "array", "items": { "type": "object" } },
    "direction_updates_completed": { "$ref": "#/$defs/linkList" },
    "blueprint_updates_completed": { "$ref": "#/$defs/linkList" },
    "owner": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "links": { "type": "object" },
    "legacy_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "migrated_from": { "type": ["object", "null"] }
  },
  "$defs": {
    "linkList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(dbs|https)://" },
      "uniqueItems": true
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
