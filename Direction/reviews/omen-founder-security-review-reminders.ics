BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Valor Ventures LLC//Omen Security Review Reminders//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Omen Security Reviews
X-WR-TIMEZONE:America/New_York
BEGIN:VTIMEZONE
TZID:America/New_York
X-LIC-LOCATION:America/New_York
BEGIN:DAYLIGHT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:omen-security-weekly@valorventures.example
DTSTAMP:20260724T010000Z
DTSTART;TZID=America/New_York:20260727T090000
DTEND;TZID=America/New_York:20260727T091500
RRULE:FREQ=WEEKLY;BYDAY=MO
SUMMARY:Omen weekly security and operations review
DESCRIPTION:Review uptime and /api/ready. Check failed deploys\, error alerts\, unexpected access\, backup status\, and billing notices.
BEGIN:VALARM
TRIGGER:-PT10M
ACTION:DISPLAY
DESCRIPTION:Omen weekly security review
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:omen-security-monthly@valorventures.example
DTSTAMP:20260724T010000Z
DTSTART;TZID=America/New_York:20260801T100000
DTEND;TZID=America/New_York:20260801T103000
RRULE:FREQ=MONTHLY;BYMONTHDAY=1
SUMMARY:Omen monthly security review
DESCRIPTION:Review users and admins\, secret rotation dates\, dependency alerts\, public endpoints\, logs\, and restore readiness.
BEGIN:VALARM
TRIGGER:-PT30M
ACTION:DISPLAY
DESCRIPTION:Omen monthly security review
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:omen-security-quarterly@valorventures.example
DTSTAMP:20260724T010000Z
DTSTART;TZID=America/New_York:20261001T100000
DTEND;TZID=America/New_York:20261001T110000
RRULE:FREQ=MONTHLY;INTERVAL=3;BYMONTHDAY=1
SUMMARY:Omen quarterly security review
DESCRIPTION:Do a backup restore drill\, access audit\, incident tabletop\, privacy review\, and vendor/account review.
BEGIN:VALARM
TRIGGER:-P1D
ACTION:DISPLAY
DESCRIPTION:Omen quarterly security review tomorrow
END:VALARM
END:VEVENT
END:VCALENDAR
